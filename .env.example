# AHL Studio — copie para .env.local e preencha. Nunca commite .env.local.

# --- Auth.js -------------------------------------------------
AUTH_SECRET=            # openssl rand -base64 32
AUTH_TRUST_HOST=true
# Google OAuth (opcional): console.cloud.google.com > APIs e serviços > Credenciais
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Mercado Pago (opcional; sem token = modo PIX manual) ----
# Use o token de TESTE (TEST-...) em dev.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# --- Banco (Turso; vazio = SQLite local ./local.db) ----------
TURSO_DATABASE_URL=     # libsql://<seu-banco>-<sua-org>.turso.io
TURSO_AUTH_TOKEN=

# --- App -----------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Seed (npm run db:seed) ----------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=    # vazio = gera senha forte e imprime uma vez

# --- Frete (opcional; cotação real) --------------------------
SUPERFRETE_TOKEN=
MELHORENVIO_TOKEN=
SHIPPING_SANDBOX=true
